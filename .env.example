# Smart Attendance System Environment Variables
# Copy this file to .env and modify the values as needed

# === Application Settings ===
APP_NAME=Smart Attendance System
DEBUG=false
HOST=0.0.0.0
PORT=8000

# === Deployment Profile ===
# Set to 'laptop' for standard execution, or 'pi3' for Raspberry Pi 3 Model B optimized settings
PROFILE=laptop

# === SSL Settings (for HTTPS, required for mobile camera) ===
USE_SSL=false
SSL_KEYFILE=  # Path to SSL key file (e.g., ./certs/localhost-key.pem)
SSL_CERTFILE=  # Path to SSL certificate file (e.g., ./certs/localhost.pem)

# === JWT Settings ===
SECRET_KEY=your-super-secret-key-change-in-production-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440  # 24 hours

# === Database ===
DATABASE_URL=sqlite:///./data/attendance.db

# === Face Recognition ===
# FACE_ENGINE=insightface # "insightface" or "opencv_sface" (auto-set by PROFILE)
# STREAM_FPS=5 # Auto-set by PROFILE
# FRAME_WIDTH=640 # Auto-set by PROFILE
# DETECT_EVERY_N_FRAMES=1 # Auto-set by PROFILE
# MAX_FACES=5 # Auto-set by PROFILE
# RECOGNITION_THRESHOLD=0.45 # Auto-set by PROFILE
FACE_MODEL_NAME=buffalo_s
LIVENESS_CHECK=true

# === Hardware / Edge Settings (Pi 3 Mode) ===
LCD_MODE=parallel # "parallel" (HD44780 1602A 4-bit) or "i2c" (PCF8574 backpack)
LCD_RS_PIN=25
LCD_E_PIN=24
LCD_D4_PIN=5
LCD_D5_PIN=6
LCD_D6_PIN=13
LCD_D7_PIN=19
LCD_I2C_ADDR=39 # 0x27 in decimal (for LCD_MODE=i2c)
PIN_LED_GREEN=17
PIN_LED_RED=27
PIN_BUZZER=22
PIN_BUTTON=23

# === Edge Client Settings (edge/pi_client.py) ===
EDGE_SERVER_URL=ws://192.168.1.100:8000/api/v1/attendance/stream # or wss://...
EDGE_VERIFY_SSL=true # Set to false to bypass SSL certificate validation on trusted LAN
EDGE_CA_FILE= # Optional path to custom CA / mkcert root CA certificate (e.g., ./certs/rootCA.pem)

# === Session Timings (24-hour format) ===
MORNING_SESSION_START=08:00
MORNING_SESSION_END=09:30
AFTERNOON_SESSION_START=13:00
AFTERNOON_SESSION_END=14:00

# === Notification Settings ===
# Options: console, whatsapp, sms, email
NOTIFIER_TYPE=console

# WhatsApp Cloud Settings
WHATSAPP_TOKEN=  # Your WhatsApp Cloud API token
WHATSAPP_PHONE_NUMBER_ID=  # Your WhatsApp Phone Number ID

# SMS Settings (Fast2SMS)
FAST2SMS_API_KEY=  # Your Fast2SMS API key

# Email Settings (SMTP)
TEACHER_EMAIL=  # Email address to send reports to
SMTP_SERVER=  # SMTP server host (e.g., smtp.gmail.com)
SMTP_PORT=587  # SMTP port (usually 587 for TLS)
SMTP_USERNAME=  # SMTP username
SMTP_PASSWORD=  # SMTP password
SMTP_TLS=true  # Use TLS for SMTP

# === Auto-Report Settings ===
AUTO_REPORT_ENABLED=true
AUTO_REPORT_TIME=18:00  # Daily at 6 PM
AUTO_REPORT_RECIPIENTS=  # Comma-separated email addresses for auto-reports

# === Paths ===
FACES_DIR=./data/faces
REPORTS_DIR=./data/reports
LOGS_DIR=./data/logs
MODELS_DIR=./data/models

# === Admin User Settings (for initial setup) ===
ADMIN_PASSWORD=admin123  # Change this after first login!